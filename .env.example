# Dasselbe Secret wie in der Visibly-CMS-Verbindung
VISIBLY_WEBHOOK_SECRET=whsec_hier_eintragen
# Das SDK im Flask-Starter liest diesen Namen: gleichen Wert eintragen
CONTENTPILOT_WEBHOOK_SECRET=whsec_hier_eintragen

# API-Key aus Visibly (Einstellungen -> API-Key, oder projektgebunden cp_...)
VISIBLY_API_KEY=lc_hier_eintragen

# Oeffentliche Basis-URL dieser Seite: daraus entsteht die URL, die an Visibly
# zurueckgemeldet wird.
SITE_URL=http://localhost:4321

# Wo die Artikel liegen. Auf Railway MUSS das ein Volume-Mount sein.
CONTENT_DIR=/data/content

# Nur fuer abweichende Installationen
# VISIBLY_BASE_URL=https://app.visibly-ai.com
